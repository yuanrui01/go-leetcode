package main

// 731. 我的日程安排表 II
type MyCalendarTwo struct {
	booked [][]int
}

func Constructor() MyCalendarTwo {
	return MyCalendarTwo{
		booked: [][]int{},
	}
}

func (this *MyCalendarTwo) Book(startTime int, endTime int) bool {
	var overlap [][]int
	for _, x := range this.booked {
		l := x[0]
		r := x[1]
		if r > startTime && l < endTime {
			for _, y := range overlap {
				if y[1] > l && y[0] < r {
					return false
				}
			}
			overlap = append(overlap, []int{max(startTime, l), min(endTime, r)})
		}
	}
	this.booked = append(this.booked, []int{startTime, endTime})
	return true
}

func main() {
	myCalendar2 := Constructor()
	testData := []int{10, 20, 50, 60, 10, 40, 5, 15, 5, 10, 25, 55}
	testSize := len(testData)
	for i := 0; i < testSize; i += 2 {
		println(myCalendar2.Book(testData[i], testData[i+1]))
	}
}
